<%-layout("layouts/boilerplate.ejs")%>
   <div class="d-flex justify-content-center">
  <div class="c-area" style="width: 55rem;">
    <h3><%= item.title %></h3>

    <div class="c">
      <img class="img card-img-top" style="height:350px" src="<%= item.image.url %>">

      <p>Owned by <i><%=item.owner.username%></i></p>

      <p><%= item.description %></p>
      <p> <%= item.category %></p>
      <p><%= item.location %></p>
      <p><%= item.country %></p>
      <p>₹<%= item.price %>/-</p>
      
  <%if(currUser && item.owner._id.equals(currUser._id)){%>
    <div class="d-flex justify-content-between">
     <a class="btn btn-danger" href="/home/<%= item._id %>/edit">Edit</a>
    <form method="POST" action="/home/<%=item._id%>/Delete?_method=DELETE">
            <button class="btn btn-outline-danger" type="submit">Delete</button>
    </form>
    </div>
<%}%>
 
<% if(currUser) {%>
     <div>
      <hr/>
      <h3>
        Review Here!
      </h3>
      <form method="POST" action="/home/<%=item.id%>/review" novalidate class="needs-validation" >

        <fieldset class="starability-basic">
  <legend>First rating:</legend>
  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked aria-label="No rating." />
  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
  <label for="first-rate1" title="Terrible">1 star</label>
  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
  <label for="first-rate2" title="Not good">2 stars</label>
  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
  <label for="first-rate3" title="Average">3 stars</label>
  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
  <label for="first-rate4" title="Very good">4 stars</label>
  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
  <label for="first-rate5" title="Amazing">5 stars</label>
</fieldset>


          <!-- <label for="rating" ></label>
          <input class="form-range" min="1" max="5" type="range" id="rating" name="review[rating]"> -->



          <br/>
          <label class="form-label"></label>
          <textarea required class="form-control" id="comment" name="review[comment]" rows="5" ></textarea>
          <div class="invalid-feedback">
            kindly fill the appropriate feedback
          </div>
          <br/>
          <label for="submit"></label>
          <button title="Submit here!" class="btn btn-outline-danger" type="submit"  id="submit"> Submit</button>
          </form>
          <hr/>
          <%}%>
          
<% if(item.reviews.length !==0){%>
<div class="row">
  <h4>
     All reviews!
  </h4>
  <% for (review of item.reviews) { %>
    <div class="review-card mb-2 ms-5  col-5">
      <div class="review-card-body">
        <div class="card-title"> 
          <strong>By: <%= review.author.username %></strong>
        </div>

        <div class="card-text">
             <%= review.comment %>
        </div>
        

         <p class="starability-result" data-rating="<%= review.rating %>">
    Rated: <%= review.rating %> stars
  </p>
   <% } %>

<% if(currUser && review.author._id.equals(currUser._id)){%>
        <form method="POST" action="/home/<%=item.id%>/review/<%=review.id%>?_method=DELETE">
          <button class="btn btn-outline-danger mt-3" >
            delete the review
          </button>
        </form>
<%}%>

      </div>
      </div>
  </div>
  <%}%>

<div id="map"
     data-coordinates='<%= JSON.stringify(item.geometry.coordinates) %>'
     data-location="<%= item.location %>"
     data-country="<%= item.country %>">
    you will be here!
</div>

    </div>
  </div>
</div>
</div>

<!-- documentation -->
<script
    src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
    integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
    crossorigin="">
</script>

<!-- documentation -->
<script>

    const mapElement = document.getElementById("map");

    const coordinates = JSON.parse(
        mapElement.dataset.coordinates
    );

    const longitude = coordinates[0];
    const latitude = coordinates[1];

    const map = L.map("map").setView(
        [latitude, longitude],
        13
    );

    L.tileLayer(
        "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
        {
            maxZoom: 19,
            attribution: "&copy; OpenStreetMap contributors"
        }
    ).addTo(map);

    L.marker([latitude, longitude])
        .addTo(map)
        .bindPopup(
            `${mapElement.dataset.location}, ${mapElement.dataset.country}`
        )
        .openPopup();

</script>