<%-layout("layouts/boilerplate.ejs")%>

   <div class="d-flex justify-content-center">
  <div class="c-area" style="width: 24rem;">
    <h3><%= item.title %></h3>

    <div class="c">
      <img class="img card-img-top" style="height:350px" src="<%= item.image.url %>">

      <p><%= item.description %></p>
      <p><%= item.location %></p>
      <p><%= item.country %></p>
      <p>₹<%= item.price %>/-</p>

      <!-- <form method="GET" action="/home"> -->

        <form method="POST" action="/home/<%=item._id%>/Delete?_method=DELETE">
            <button class="btn btn-outline-danger" type="submit">Delete</button>
        </form>
    </div>
  </div>
</div>