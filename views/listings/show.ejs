<%-layout("layouts/boilerplate.ejs")%>

   <div class="d-flex justify-content-center">
  <div class="c-area" style="width: 24rem;">
    <h3><%= item.title %></h3>

    <div class="c">
      <img class="img card-img-top" style="height:350px" src="<%= item.image.url %>">

      <p><%= item.description %></p>
      <p><%= item.location %></p>
      <p><%= item.country %></p>
      <p>₹<%= item.price %>/-</p>

      <!-- <form method="GET" action="/home"> -->

        <a href="/home" class="btn btn-danger"
        >Go back to home</a>
    </div>
  </div>
</div>