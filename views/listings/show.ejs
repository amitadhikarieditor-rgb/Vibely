<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>show</title>
</head>
<body>
    <h3>
        <%= item.title %>
    </h3>

    <ul>
        <li><%= item.title %></li>
         <li><%= item.description %></li>
          <li><img class="img" src="<%= item.image.url %>" alt="<%= item.image %>"></li>
           <li><%= item.location %></li>
            <li><%= item.country %></li>
            <li><%= item.price %>/-</li>
    </ul>
</body>
</html>