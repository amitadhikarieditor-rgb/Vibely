  <% layout("layouts/boilerplate") %>
<div class="page">
    <h2 class="h" >
        Create a New Listing
    </h2>
    <form class="needs-validation" novalidate method="POST" action="/home/new" enctype="multipart/form-data">
        <div class="mb-2 new">


            <label for="title" class="form-label">Your property's Identity</label>
            <input required class="form-control" id="title " placeholder="Title" name="listing[title]" type="text">
            <div class="invalid-feedback">
                Please enter a title.
            </div>
            <div class="valid-feedback">
                title Looks Good.
            </div>


    <label for="description" class="form-label">Description</label>
    <textarea required class="form-control" id="description" rows="3"  placeholder="Add Description" name="listing[description]" type="text"></textarea>
    <div class="invalid-feedback">
                Please enter a Description
            </div>
            <div class="valid-feedback">
                 Nice.
            </div>
    


    <label for="location" class="form-label">Enter the Location</label>
    <input required class="form-control" id="location" 
     placeholder="Location"
     name="listing[location]"
     type="text"
     enctype="multipart/form-data"> 

    <div class="invalid-feedback">
                Please enter a valid location
            </div>
            <div class="valid-feedback">
                Thanks for entering
            </div>

            <div class="mb-3">
    <label for="category" class="form-label">Category</label>

    <select name="listing[category]" id="category" class="form-select">
        <option value="Rooms">Rooms</option>
        <option value="Mountains">Mountains</option>
        <option value="Hiking">Hiking</option>
        <option value="Beach">Beach</option>
        <option value="Lakefront">Lakefront</option>
        <option value="Farmhouses">Farmhouses</option>
        <option value="Forest">Forest</option>
        <option value="Camping">Camping</option>
        <option value="Snow">Snow</option>
        <option value="Waterfront">Waterfront</option>
        <option value="City">City</option>
        <option value="Luxury">Luxury</option>
        <option value="Pool">Pool</option>
        <option value="Boats">Boats</option>
        <option value="Countryside">Countryside</option>
        <option value="Islands">Islands</option>
        <option value="Glamping">Glamping</option>
        <option value="Castles">Castles</option>
        <option value="Cabins">Cabins</option>

    </select>
</div>
