<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <form method="POST" action="/home/<%=edit._id%>/edit?_method=PATCH">
    <input placeholder="Title" name="title" type="text" value=<%=edit.title%>>
    <br/>
    <br/>
    <textarea rows="5" cols="30" placeholder="Description" name="description" type="text"><%=edit.description%> </textarea>
    <br/>
    <br/>
    <input placeholder="Location" name="location" type="text" value=<%=edit.location%>>
    <br/>
    <br/>
    <input placeholder="Country" name="country" type="text" value=<%=edit.country%>>
    <br/>
    <br/>
    <img src="<%= edit.image.url %>" width="300">
    <input name="image[url]" type="url" value="<%= edit.image.url %>">
    <br/>
    <br/>
    <input placeholder="Price" name="price" type="number" value=<%=edit.price%>>
    <br/>
    <br/>
    
        <button>
            Save changes
        </button>
</form>
</body>
</html>