<% layout("layouts/boilerplate") %>
<div class="row g-0 item-container">
<% for(let item of items){%>
    <div class="col-12 col-sm-6 col-lg-4" >

<div class="card">
  <div class="card-body">
  
            <a href="/home/<%=item._id%>/show">
            <img class="card-img-top" src="<%= item.image.url %>" alt="<%= item.image %>">
            <h3><%= item.title %></h3>
            <%= item.description %>
            <br/>
            <%= item.location %>
            <br/>
            <%= item.country %>
            <br/>
             &#8377;<%= item.price.toLocaleString("en-IN") %>/- night
        </a>
    
    <form method="POST" action="/home/<%=item._id%>/edit?_method=PATCH">
    <button class="btn btn-dark" type="submit">Edit</button>
</form>
</form>
<br/>
        <form method="POST" action="/home/<%=item._id%>/Delete?_method=DELETE">
            <button class="btn btn-outline-danger" type="submit">Delete</button>
        </form>
  </div>
</div>
</div> 

<%}%>
</div>
<br/>
    <form method="get" Action="/home/new">
        
        <a class="btn btn-outline-danger" href="/home/new">
            Create new list
        </a> 
    </form>



