<% layout("layouts/boilerplate") %> 

<style>
 #filters {
    display: flex;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    height: 65px;
    white-space: nowrap;
    padding: 5px 5px;
 }
 .filters{
    margin-right: 2rem;
    margin-left:1rem;
   text-align: center;
   opacity:0.4;
   padding: 5px 5px;
 }
 #filters a{
    text-decoration: none;
 }

 .filters:hover{
    opacity:1;
    text-decoration: 3px underline ;
    transition: all 0.3s;
    cursor: pointer;
 }

 

 
</style>

