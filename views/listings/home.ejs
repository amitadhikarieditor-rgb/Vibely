            <a href="/home/<%=item._id%>/show">
            <img loading="lazy" class="card-img-top" src="<%= item.image.url %>" alt="<%= item.image %>">
            <h3><%= item.title %></h3>
            <%= item.description %>
            <br/>
            <%= item.location %>
            <br/>
            <%= item.country %>
            <br/>
             &#8377;<%= item.price.toLocaleString("en-IN") %>/- night
        </a>
    
